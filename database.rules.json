{
  "rules": {
    ".read": false,
    ".write": false,
    "members": {
      ".read": false,
      ".write": false
    },
    "status": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && root.child('members').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['state', 'at']) && newData.child('state').isString() && newData.child('state').val().matches(/^(online|away|offline)$/)",
        "state": {
          ".validate": "newData.isString()"
        },
        "room": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z][a-z0-9_:-]{0,31}$/)"
        },
        "nick": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$id": {
          ".write": "auth != null && auth.uid === $uid && !newData.exists()"
        }
      }
    },
    "parties": {
      "$pid": {
        ".read": "auth != null && data.child('members').child(auth.uid).exists()",
        ".write": false
      }
    },
    "invites": {
      ".read": false,
      ".write": false
    },
    "partyOf": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "traces": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": false
    },
    "lostFound": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": false
    },
    "workers": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": false
    },
    "titles": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": false,
      "$uid": {
        ".validate": "newData.hasChildren(['id', 'name']) && newData.child('id').isString() && newData.child('id').val().length <= 40 && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 12",
        "id": { ".validate": "newData.isString()" },
        "name": { ".validate": "newData.isString()" },
        "$other": { ".validate": false }
      }
    },
    "casinoLive": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": false,
      ".validate": "newData.hasChildren(['seq'])",
      "seq": { ".validate": "newData.isNumber()" },
      "uid": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" },
      "nick": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
      "since": { ".validate": "newData.isNumber()" },
      "until": { ".validate": "newData.isNumber()" },
      "msg": {
        ".validate": "newData.hasChildren(['id', 'at', 'from', 'to', 'n'])",
        "id": { ".validate": "newData.isNumber()" },
        "at": { ".validate": "newData.isNumber()" },
        "from": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
        "to": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
        "toUid": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" },
        "n": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "$other": { ".validate": false }
    },
    "lounge": {
      ".read": "auth != null && root.child('members').child(auth.uid).exists()",
      ".write": false
    },
    "coopTalkLog": {
      ".read": false,
      ".write": false
    },
    "coopReports": {
      ".read": false,
      ".write": false
    },
    "coopChat": {
      "$pid": {
        ".read": "auth != null && root.child('parties').child($pid).child('members').child(auth.uid).exists()",
        ".write": false
      }
    },
    "casinoView": {
      "$pid": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "casinoChat": {
      "$pid": {
        ".read": "auth != null && root.child('parties').child($pid).child('members').child(auth.uid).exists()",
        ".write": false
      }
    },
    "coopView": {
      "$pid": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    }
  }
}
