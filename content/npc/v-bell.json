    "lines": {
      "accept": [
        "好，我帶帳本去。",
        "可以，帳我可以晚點對。"
      ],
      "refuse": [
        "今天帳還沒對完。",
        "還有幾行要點名。"
      ],
      "sit": [
        "我坐下，先對壹遍帳。",
